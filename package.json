{
  "name": "@jlongo78/agent-spaces",
  "version": "1.0.9",
  "description": "Agent workspace manager for Claude, Codex, Gemini, and more",
  "bin": {
    "spaces": "./bin/spaces.js",
    "spaces-msg": "./bin/spaces-msg.js",
    "spaces-tui": "./bin/spaces-tui.js"
  },
  "files": [
    "bin/",
    "src/lib/terminal/collaboration.js",
    ".next/standalone/",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jlongo78/spaces.git"
  },
  "keywords": [
    "ai",
    "agent",
    "workspace",
    "terminal",
    "claude",
    "codex",
    "gemini"
  ],
  "homepage": "https://www.agentspaces.co",
  "bugs": {
    "url": "https://github.com/jlongo78/spaces/issues"
  },
  "author": "John Longo",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "node bin/spaces.js",
    "dev": "node bin/spaces-dev.js",
    "build": "cross-env STANDALONE=1 NODE_PATH=./node_modules next build && node -e \"const fs=require('fs');fs.cpSync('.next/static','.next/standalone/.next/static',{recursive:true});fs.cpSync('public','.next/standalone/public',{recursive:true})\" && node bin/fix-standalone-externals.js",
    "postinstall": "node bin/spaces-postinstall.js || true",
    "prepublishOnly": "npm run build",
    "prepack": "node bin/scrub-standalone.js",
    "setup": "node bin/spaces-setup.js",
    "setup-admin": "node bin/setup-admin.js",
    "server:build": "next build",
    "server:start": "next start --port 3457",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint",
    "proto:schema": "node scripts/export-protocol-schema.mjs",
    "proto:check": "node scripts/export-protocol-schema.mjs --check",
    "proto:docs": "node scripts/check-protocol-docs.mjs"
  },
  "dependencies": {
    "@google-cloud/compute": "^6.9.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^5.5.0",
    "better-sqlite3": "^12.6.2",
    "bonjour-service": "^1.3.0",
    "node-pty": "^1.1.0",
    "ws": "^8.19.0",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "overrides": {
    "zod": "$zod",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@react-three/postprocessing": "^3.0.4",
    "@react-three/xr": "^6.6.29",
    "@tailwindcss/postcss": "^4",
    "@tanstack/react-query": "^5.90.21",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.183.1",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.0.18",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "chokidar": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "date-fns": "^4.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "geist": "^1.4.1",
    "lucide-react": "^0.575.0",
    "next": "16.4.3",
    "otpauth": "^9.5.0",
    "posthog-js": "^1.352.0",
    "posthog-node": "^5.21.2",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.7.6",
    "recharts": "^3.7.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4",
    "three": "^0.183.2",
    "typescript": "^5",
    "vitest": "^4.0.18",
    "xterm": "^5.3.0"
  },
  "optionalDependencies": {
    "@jlongo78/agent-spaces-tui-darwin-arm64": "1.0.9",
    "@jlongo78/agent-spaces-tui-darwin-x64": "1.0.9",
    "@jlongo78/agent-spaces-tui-linux-arm64": "1.0.9",
    "@jlongo78/agent-spaces-tui-linux-x64": "1.0.9",
    "@jlongo78/agent-spaces-tui-win32-x64": "1.0.9",
    "otpauth": "^9.5.0",
    "qrcode": "^1.5.4"
  }
}
